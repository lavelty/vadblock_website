# Paddle Configuration
# Options: 'sandbox' or 'production'
PADDLE_ENVIRONMENT=sandbox

# Client-side token for Paddle.js (starts with test_ for sandbox, live_ for production)
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side API key (never expose to client)
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxx

# Webhook notification signing secret (never expose to client)
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxx
